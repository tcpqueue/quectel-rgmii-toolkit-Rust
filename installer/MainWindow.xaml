<UserControl x:Class="SimpleAdminSetup.InstallerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="Microsoft YaHei UI" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
    <Grid.Resources>
      <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="20" />
      </Style>
    </Grid.Resources>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel Spacing="12" Margin="28,20,28,12">
        <TextBlock Text="移远高通系列5G模块配置与维护" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="从连接模块到安装后台，按步骤完成配置；已有 ADB 可直接进入安装。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Button x:Name="GoPrepare" HorizontalAlignment="Stretch" Content="① 识别模块" />
          <TextBlock Grid.Column="1" Text="→" VerticalAlignment="Center" />
          <Button x:Name="GoAdb" Grid.Column="2" HorizontalAlignment="Stretch" Content="② ADB 连接" />
          <TextBlock Grid.Column="3" Text="→" VerticalAlignment="Center" />
          <Button x:Name="GoNetwork" Grid.Column="4" HorizontalAlignment="Stretch" Content="③ 联网配置" />
          <TextBlock Grid.Column="5" Text="→" VerticalAlignment="Center" />
          <Button x:Name="GoInstall" Grid.Column="6" HorizontalAlignment="Stretch" Content="④ 安装升级" />
          <TextBlock Grid.Column="7" Text="→" VerticalAlignment="Center" />
          <Button x:Name="GoVerify" Grid.Column="8" HorizontalAlignment="Stretch" Content="⑤ 检查完成" />
        </Grid>
      </StackPanel>
      <ScrollViewer x:Name="MainPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,8,28,24" Spacing="16">
          <StackPanel Margin="0" Spacing="16" x:Name="PreparePage">
            <TextBlock Text="连接与准备" Style="{ThemeResource TitleTextBlockStyle}" FontSize="22" />
            <TextBlock Text="仅适配已识别的移远高通 RG/RM 型号。已有 ADB 连接可直接前往安装。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Border Style="{StaticResource Card}">
              <StackPanel Spacing="12">
                <TextBlock Text="1. 选择 AT 串口" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="优先选择名称中含 Quectel 和 AT 的端口。请先关闭其他串口软件。选择端口不会自动发送指令。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ComboBox x:Name="AtPorts" PlaceholderText="请选择 AT 串口" HorizontalAlignment="Stretch" AutomationProperties.Name="AT 串口" />
                  <Button x:Name="ScanPorts" Grid.Column="1" Content="刷新" />
                  <Button x:Name="IdentifyModule" Grid.Column="2" Content="识别模块" Style="{StaticResource AccentButtonStyle}" />
                </Grid>
                <InfoBar x:Name="PrepareStatus" IsOpen="True" IsClosable="False" Severity="Informational" Title="尚未识别" Message="连接模块后刷新串口，选择端口并点击识别。" />
                <ProgressBar x:Name="AtProgress" IsIndeterminate="False" Visibility="Collapsed" />
                <TextBlock x:Name="ModuleSummary" Text="型号、固件和连接建议将在这里显示。" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" x:Name="AdbSection">
              <StackPanel Spacing="12">
                <TextBlock Text="2. 开启 ADB 连接" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="先检查 USB 配置倒数第二项：1 或 2 表示 ADB 已开启，直接跳过解锁；仅在值为 0 时计算密钥并启用 ADB。保留其他 USB 设置，重启需单独确认。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button x:Name="UnlockAdb" Content="检查并解锁 ADB" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" />
                  <Button x:Name="RestartModule" Content="重启模块" IsEnabled="False" />
                  <Button x:Name="ContinueInstall" Content="前往安装 →" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Expander Header="3. 联网配置 · PCIe / ECM / RNDIS" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" x:Name="NetworkSection" IsExpanded="True">
              <StackPanel Spacing="12">
                <TextBlock Text="网卡型号以转接板为准；指令返回 OK 仅表示配置被接受，网口是否联网仍需检查网线、SIM 和 APN。" TextWrapping="Wrap" />
                <ComboBox x:Name="EthernetDriver" Header="转接板网卡" SelectedIndex="0" HorizontalAlignment="Stretch">
                  <ComboBoxItem Content="RTL8125 · 2.5G 网卡" Tag="r8125" />
                  <ComboBoxItem Content="RTL8168 · 千兆网卡" Tag="r8168" />
                </ComboBox>
                <ComboBox x:Name="EthernetProfile" Header="连接方案" SelectedIndex="0" HorizontalAlignment="Stretch">
                  <ComboBoxItem Content="PCIe 转网口 · QMAPWAC 自动拨号" />
                  <ComboBoxItem Content="ECM · USB 网卡 + QMAPWAC 自动拨号" />
                  <ComboBoxItem Content="RNDIS · USB 网卡 + QMAPWAC 自动拨号" />
                </ComboBox>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button x:Name="EnableEthernet" Content="预览并应用方案" IsEnabled="False" />
                  <Button x:Name="DisableEthernet" Content="停用此方案…" IsEnabled="False" />
                </StackPanel>
              </StackPanel>
            </Expander>
            <Expander Header="设备信息 · 手动读取，不持续轮询" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="12">
                <Button x:Name="ReadModuleInfo" Content="读取设备信息" IsEnabled="False" />
                <TextBlock Text="SIM、信号、温度、USB 和网口配置分项显示。不支持的查询会标记为“固件未提供”。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel x:Name="ModuleInfo" Spacing="8" />
              </StackPanel>
            </Expander>
            <Expander Header="高级 AT 工具" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="12">
                <TextBlock Text="每行一条指令，最多 32 条。执行前确认完整列表；遇到错误立即停止。不会自动运行或循环发送。" TextWrapping="Wrap" />
                <ComboBox x:Name="AtPreset" Header="常用查询" SelectedIndex="0" HorizontalAlignment="Stretch">
                  <ComboBoxItem Content="选择后填入编辑框" Tag="" />
                  <ComboBoxItem Content="查询信号和服务小区" Tag="AT+QENG=&quot;servingcell&quot;&#xA;AT+QRSRP&#xA;AT+QSINR" />
                  <ComboBoxItem Content="查询 USB 和网口配置" Tag="AT+QCFG=&quot;usbcfg&quot;&#xA;AT+QETH=&quot;eth_driver&quot;&#xA;AT+QCFG=&quot;pcie/mode&quot;" />
                  <ComboBoxItem Content="查询固件和温度" Tag="AT+QGMR&#xA;AT+QTEMP" />
                </ComboBox>
                <TextBox x:Name="CustomAt" AcceptsReturn="True" TextWrapping="Wrap" Height="140" MaxLength="16416" PlaceholderText="例如 AT+QNWINFO" AutomationProperties.Name="自定义 AT 指令" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button x:Name="RunCustomAt" Content="预览并执行" IsEnabled="False" />
                  <Button x:Name="SaveAtPreset" Content="保存到此电脑" />
                  <Button x:Name="LoadAtPreset" Content="读取已保存指令" />
                </StackPanel>
                <Button x:Name="FactoryReset" Content="恢复模块出厂设置…" IsEnabled="False" />
              </StackPanel>
            </Expander>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="操作记录" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button x:Name="StopAt" Grid.Column="1" Content="停止后续操作" IsEnabled="False" Margin="0,0,8,0" />
              <Button x:Name="SaveAtLog" Grid.Column="2" Content="保存记录" />
            </Grid>
            <TextBox x:Name="AtLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="140" ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" />
            <TextBlock Text="操作记录仅保存在电脑内存，点击保存后写入电脑。解锁密钥不显示也不写入记录。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
          <StackPanel Spacing="16" Margin="0,24,0,0" x:Name="InstallPage">
            <StackPanel Spacing="6" Margin="0,0,0,4">
              <TextBlock Text="让设备准备就绪" Style="{ThemeResource TitleTextBlockStyle}" />
              <TextBlock Text="连接模块，一站完成安装、检查与管理。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Border Style="{StaticResource Card}">
              <StackPanel Spacing="12">
                <Grid>
                  <TextBlock Text="连接设备" FontSize="17" FontWeight="SemiBold" />
                  <TextBlock x:Name="DeviceBadge" Text="正在检测" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
                <Grid ColumnSpacing="10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ComboBox x:Name="Devices" HorizontalAlignment="Stretch" PlaceholderText="请选择模块" AutomationProperties.Name="选择 ADB 设备" />
                  <Button x:Name="Refresh" Grid.Column="1" Content="刷新" />
                </Grid>
                <TextBlock x:Name="DeviceHint" Text="使用 USB 连接模块，设备会自动出现在这里。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="8">
                  <TextBlock Text="安装或升级" FontSize="17" FontWeight="SemiBold" />
                  <TextBlock Text="安装完整程序与网页，升级保留有效配置和密码。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  <TextBlock Text="首次安装默认账号密码：admin / admin" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                  <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                    <CheckBox x:Name="ChangeHttpPort" Content="修改 HTTP 端口" />
                    <TextBox x:Name="HttpPort" Text="80" Width="88" MaxLength="5" VerticalAlignment="Center" AutomationProperties.Name="HTTP 服务端口" />
                  </StackPanel>
                  <TextBlock Text="不勾选：首次使用 80，升级保留原端口。可填 1–65535。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  <StackPanel Spacing="10" Margin="0,8,0,0">
                    <CheckBox x:Name="ChangeWebCredentials" Content="设置 Web 账号和密码" />
                    <Grid ColumnSpacing="12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                      </Grid.ColumnDefinitions>
                      <TextBox x:Name="WebUsername" Header="Web 账号" Text="admin" MaxLength="64" IsEnabled="False" />
                      <PasswordBox x:Name="WebPassword" Grid.Column="1" Header="Web 密码" Password="admin" MaxLength="128" IsEnabled="False" />
                    </Grid>
                    <CheckBox x:Name="ChangeRootPassword" Content="设置系统 root 密码" />
                    <PasswordBox x:Name="RootPassword" Header="root 密码" Password="admin" MaxLength="128" IsEnabled="False" />
                    <TextBlock Text="首次安装默认端口 80，Web 账号、Web 密码和 root 密码均为 admin。升级不勾选则保留已有值；勾选后使用填写的值。密码不写入安装日志。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  </StackPanel>
                </StackPanel>
                <Button x:Name="Install" Grid.Column="1" Content="安装 / 升级" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" Padding="20,10" />
              </Grid>
            </Border>
            <Border Style="{StaticResource Card}" x:Name="VerifySection">
              <StackPanel Spacing="12">
                <Grid ColumnSpacing="10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="StatusTitle" Text="等待连接设备" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock x:Name="ProgressLabel" Grid.Column="1" Text="准备就绪后即可开始" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </Grid>
                <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Value="0" />
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="Step1" Text="① 检查连接" FontSize="12" />
                  <TextBlock x:Name="Step2" Grid.Column="1" Text="② 上传文件" FontSize="12" />
                  <TextBlock x:Name="Step3" Grid.Column="2" Text="③ 安装程序" FontSize="12" />
                  <TextBlock x:Name="Step4" Grid.Column="3" Text="④ 验证网页" FontSize="12" />
                </Grid>
                <TextBlock x:Name="StatusDetail" Text="操作进度和结果会显示在这里。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </Border>
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Button x:Name="Diagnose" Content="故障诊断" HorizontalAlignment="Stretch" ToolTipService.ToolTip="收集只读报告，不重新安装或修改设置。" />
              <Button x:Name="OpenWeb" Grid.Column="1" Content="打开管理页面" HorizontalAlignment="Stretch" ToolTipService.ToolTip="检查网页后，通过 USB / ADB 打开设备后台。" />
            </Grid>
            <Expander x:Name="Details" Header="实时运行日志" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="10">
                <CheckBox x:Name="FollowLog" Content="自动滚动到最新日志" IsChecked="True" />
                <TextBox x:Name="Log" IsReadOnly="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Height="165" AutomationProperties.Name="实时运行日志" />
              </StackPanel>
            </Expander>
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="Footer" Text="Monologue&amp;蓝天科技 版权所有&#xA;诊断不会读取短信或执行 AT 指令" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
              <Button x:Name="Report" Grid.Column="1" Content="查看报告 ↗" IsEnabled="False" />
            </Grid>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>